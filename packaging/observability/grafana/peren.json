          "legendFormat": "cache"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(peren_ai_duration_ms_bucket[5m])) by (le))",
          "refId": "ai",
          "legendFormat": "ai"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Binding and outbound rate",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(peren_service_fetches_total[5m]))",
          "refId": "service/s",
          "legendFormat": "service/s"
        },
        {
          "expr": "sum(rate(peren_object_fetches_total[5m]))",
          "refId": "durable object/s",
          "legendFormat": "durable object/s"
        },
        {
          "expr": "sum(rate(peren_outbound_fetches_total[5m]))",
          "refId": "outbound/s",
          "legendFormat": "outbound/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Binding and outbound latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(peren_service_duration_ms_bucket[5m])) by (le))",
          "refId": "service",
          "legendFormat": "service"
