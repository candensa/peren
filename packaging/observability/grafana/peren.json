    {
      "id": 17,
      "type": "timeseries",
      "title": "Errors by subsystem",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(peren_http_errors_total[5m]))",
          "refId": "http",
          "legendFormat": "http"
        },
        {
          "expr": "sum(rate(peren_queue_errors_total[5m]))",
          "refId": "queue",
          "legendFormat": "queue"
        },
        {
          "expr": "sum(rate(peren_r2_errors_total[5m]))",
          "refId": "r2",
          "legendFormat": "r2"
        },
        {
          "expr": "sum(rate(peren_kv_errors_total[5m]))",
          "refId": "kv",
          "legendFormat": "kv"
        },
        {
          "expr": "sum(rate(peren_d1_errors_total[5m]))",
          "refId": "d1",
          "legendFormat": "d1"
        },
        {
          "expr": "sum(rate(peren_cache_errors_total[5m]))",
          "refId": "cache",
          "legendFormat": "cache"
        },
        {
          "expr": "sum(rate(peren_ai_errors_total[5m]))",
          "refId": "ai",
          "legendFormat": "ai"
        },
        {
          "expr": "sum(rate(peren_service_errors_total[5m]))",
          "refId": "service",
          "legendFormat": "service"
        },
        {
          "expr": "sum(rate(peren_object_errors_total[5m]))",
          "refId": "object",
          "legendFormat": "object"
        },
        {
          "expr": "sum(rate(peren_outbound_errors_total[5m]))",
          "refId": "outbound",
          "legendFormat": "outbound"
        }
